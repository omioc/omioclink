# 离线部署（server/docker-compose.yml）的变量模板：复制成同目录的 .env 后按需修改
#   cp .env.example .env
#
# 内容与 deploy/.env.example 完全一致（只分两处放，各自 cp 一条命令即可）——
# 改变量时两边要同步，否则两种部署方式的行为会不一样。
# 构建期的依赖源（PIP_INDEX_URL）只对 --build 有效，见 docker-compose.yml 里的注释。

# --- 必填 ---
# HS256 要求至少 32 字节。Linux/macOS: openssl rand -hex 32
# Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
OMIOCLINK_JWT_SECRET=

# --- 可选 ---
# 是否允许用户自行注册。默认 false：账号由你控制开放时机（改为 true 注册完再关回去）
# 也可以在管理页上临时切换（重启后回到这里的值）
OMIOCLINK_ALLOW_REGISTRATION=false

# 是否暴露 /docs（Swagger UI）与 /openapi.json。默认 false：
# 它们会把整个 API 面公开给任何能访问端口的人
OMIOCLINK_DOCS_ENABLED=false

# Web 管理页令牌。留空 = 完全关闭（/admin 与 /api/v1/admin/* 连路由都不存在，对外 404）
# 填上之后访问 http://你的服务器:21077/admin ，在页面里输入这个令牌即可
# 建议用和 JWT 密钥同样的方式随机生成，且两者不要相同
OMIOCLINK_ADMIN_TOKEN=

# 下发给客户端的 STUN 服务器列表（逗号分隔，只填 stun:，本项目不使用 TURN）
# 不含 stun.l.google.com：国内基本不可达，配了只会白做一次候选收集。
# 打开 `docker compose --profile stun up -d` 后换成自建地址即可，只填这一个，例如
#   stun:你的公网IP:3478
OMIOCLINK_ICE_SERVERS=stun:stun.cloudflare.com:3478

# 21077 端口的绑定地址。前面挂 TLS 反代时建议收紧为 127.0.0.1
OMIOCLINK_BIND_ADDR=0.0.0.0

# CORS 允许来源
OMIOCLINK_CORS_ORIGINS=*

# 数据目录：头像文件落在 <数据目录>/avatars/。容器里与 SQLite 共用 /app/data 这个卷，
# 备份时把卷一起拿走即可（不需要改，除非你把数据盘挂到别处）
# OMIOCLINK_DATA_DIR=/app/data

# 单张头像的字节上限（默认 2 MiB）。客户端会先把图缩到 256px 再上传，正常远小于这个值
# OMIOCLINK_AVATAR_MAX_BYTES=2097152

# 点歌台功能开关
OMIOCLINK_MUSIC_ENABLED=true

# 用哪个镜像。默认 Docker Hub 上的 latest；要固定版本（回滚方便）就换成带版本号的 tag，
# 例如 omioc/omioclink:v1.0.1。留注释即用默认值
# OMIOCLINK_IMAGE=omioc/omioclink:latest
